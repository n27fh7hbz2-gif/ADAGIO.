<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description"
        content="ADAGIO: proyecto audiovisual universitario y consulta psicológica ficticia.">

  <title>ADAGIO — Un espacio para escucharse</title>

  <style>
    /* =====================================
       PALETA DE COLORES
       ===================================== */
    :root {
      --fondo: #1B2845;
      --tarjeta: #274060;
      --azul-medio: #335C81;
      --azul-claro: #65AFFF;
      --azul-acento: #5899E2;
      --texto: #FFFFFF;
      --texto-suave: #DCEAFF;
    }

    /* =====================================
       DISEÑO GENERAL
       ===================================== */
    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: var(--fondo);
      color: var(--texto);
      font-family: Arial, Helvetica, sans-serif;
      font-size: 16px;
      line-height: 1.65;
    }

    .contenedor {
      width: min(1150px, calc(100% - 48px));
      margin: auto;
    }

    h1, h2, h3 {
      font-family: Georgia, "Times New Roman", serif;
      font-weight: normal;
      line-height: 1.15;
    }

    a {
      color: inherit;
    }

    a:focus-visible {
      outline: 3px solid #FFFFFF;
      outline-offset: 5px;
    }

    section {
      scroll-margin-top: 24px;
    }

    .categoria {
      font-size: 16px;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .boton,
    .volver {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 12px 22px;
      background: var(--azul-claro);
      color: var(--fondo);
      border: 1px solid var(--azul-claro);
      border-radius: 4px;
      font-weight: bold;
      text-decoration: none;
    }

    .boton:hover,
    .volver:hover {
      background: var(--azul-acento);
      border-color: var(--azul-acento);
    }

    /* =====================================
       ENCABEZADO
       ===================================== */
    #encabezado .barra {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      padding: 25px 0;
      border-bottom: 1px solid var(--azul-acento);
    }

    .identidad {
      flex-shrink: 0;
    }

    .marca {
      font-family: Georgia, serif;
      font-size: 30px;
      letter-spacing: 5px;
    }

    .subtitulo-marca {
      margin: 4px 0 0;
      color: var(--texto-suave);
      font-size: 16px;
    }

    .identificacion {
      margin: 0;
      color: var(--texto-suave);
      text-align: right;
    }

    .presentacion {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 45px;
      align-items: center;
      padding: 55px 0 40px;
    }

    #encabezado h1 {
      font-size: clamp(44px, 6vw, 74px);
      letter-spacing: -2px;
      margin: 20px 0;
    }

    #encabezado h1 em {
      color: var(--azul-claro);
    }

    .descripcion {
      max-width: 600px;
      color: var(--texto-suave);
      font-size: 18px;
      margin-bottom: 25px;
    }

    .ilustracion {
      background: var(--azul-medio);
      border-radius: 150px 150px 5px 5px;
      overflow: hidden;
    }

    .ilustracion svg {
      display: block;
      width: 100%;
      height: auto;
    }

    .pie-imagen {
      color: var(--texto-suave);
      margin-top: 10px;
    }

    .equipo {
      border-top: 1px solid var(--azul-acento);
      padding: 20px 0;
    }

    .equipo p {
      margin: 8px 0;
    }

    /* =====================================
       HUB Y TARJETAS
       ===================================== */
    main {
      padding: 35px 0 55px;
    }

    #portada h2 {
      font-size: 42px;
      margin: 10px 0 18px;
    }

    .descripcion-hub {
      max-width: 700px;
      color: var(--texto-suave);
    }

    .tarjetas {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      margin-top: 30px;
    }

    .tarjeta {
      display: flex;
      flex-direction: column;
      padding: 25px;
      background: var(--tarjeta);
      border: 1px solid var(--azul-acento);
    }

    .tarjeta .numero {
      color: var(--texto-suave);
      margin: 0 0 25px;
    }

    .tarjeta h3 {
      font-size: 30px;
      margin: 0 0 15px;
    }

    .tarjeta .resumen {
      color: var(--texto-suave);
      margin: 0 0 25px;
    }

    .tarjeta .boton {
      width: 100%;
      margin-top: auto;
    }

    .tarjeta.destacada {
      background: var(--azul-medio);
    }

    .tarjeta.destacada .numero,
    .tarjeta.destacada .resumen {
      color: var(--texto);
    }

    .aviso {
      margin-top: 25px;
      padding-top: 20px;
      border-top: 1px solid var(--azul-acento);
      color: var(--texto-suave);
    }

    /* =====================================
       SECCIONES DE CONTENIDO
       Todas están visibles en la misma página.
       ===================================== */
    .seccion-contenido {
      margin-top: 40px;
      padding: 35px;
      background: var(--tarjeta);
      border: 1px solid var(--azul-acento);
      border-radius: 8px;
    }

    .seccion-contenido .categoria {
      margin-top: 30px;
      color: var(--azul-claro);
    }

    .seccion-contenido h2 {
      max-width: 850px;
      font-size: clamp(36px, 5vw, 56px);
      margin: 20px 0;
    }

    .introduccion {
      max-width: 750px;
      color: var(--texto-suave);
      font-size: 18px;
    }

    .paneles {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
      gap: 24px;
      margin-top: 30px;
    }

    .panel {
      min-width: 0;
      padding: 25px;
      background: var(--fondo);
      border: 1px solid var(--azul-acento);
    }

    .panel h3 {
      color: var(--azul-claro);
      font-size: 28px;
      margin: 0 0 15px;
    }

    .panel p {
      color: var(--texto-suave);
    }

    .pendiente {
      padding: 22px;
      background: var(--fondo);
      color: var(--texto-suave);
      border: 1px dashed var(--azul-acento);
      margin-top: 25px;
    }

    #consulta h2 em {
      color: var(--azul-claro);
    }

    /* =====================================
       FOTOS
       La altura se cambia aquí.
       ===================================== */
    .foto-bloque {
      margin: 25px 0;
    }

    .foto {
      display: block;
      width: 100%;
      height: 320px;
      object-fit: cover;
      border-radius: 6px;
      border: 1px solid var(--azul-acento);
    }

    figcaption {
      margin-top: 8px;
      color: var(--texto-suave);
      font-size: 16px;
    }

    /* =====================================
       GOOGLE FORMS
       ===================================== */
    .formulario-insertado {
      display: block;
      width: 100%;
      height: 1100px;
      border: 0;
      margin-top: 25px;
      background: #FFFFFF;
    }

    /* =====================================
       PIE DE PÁGINA
       ===================================== */
    footer {
      background: var(--tarjeta);
      padding: 35px 0;
      border-top: 1px solid var(--azul-acento);
    }

    .columnas-pie {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 30px;
    }

    footer p {
      margin: 8px 0;
      overflow-wrap: anywhere;
    }

    footer a {
      display: inline-block;
      min-height: 44px;
      padding: 10px 0;
      text-underline-offset: 4px;
    }

    .nota-final {
      margin-top: 25px;
      padding-top: 20px;
      border-top: 1px solid var(--azul-acento);
    }

    /* =====================================
       TABLETA
       ===================================== */
    @media (max-width: 900px) {
      .presentacion {
        gap: 25px;
      }

      .tarjetas,
      .columnas-pie {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    /* =====================================
       MÓVIL
       ===================================== */
    @media (max-width: 650px) {
      .contenedor {
        width: calc(100% - 36px);
      }

      #encabezado .barra {
        flex-direction: column;
        align-items: flex-start;
      }

      .identificacion {
        text-align: left;
      }

      .presentacion,
      .tarjetas,
      .paneles,
      .columnas-pie {
        grid-template-columns: 1fr;
      }

      .presentacion {
        padding-top: 30px;
      }

      .marca {
        font-size: 25px;
      }

      .seccion-contenido {
        padding: 22px;
      }

      #portada h2 {
        font-size: 36px;
      }

      .foto {
        height: 240px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }
    }
  </style>
</head>

<body>

  <!-- =====================================
       BLOQUE 1: ENCABEZADO
       ===================================== -->
  <header id="encabezado" class="contenedor">

    <div class="barra">
      <div class="identidad">
        <div class="marca">ADAGIO.</div>
        <p class="subtitulo-marca">Consulta ficticia</p>
      </div>

      <p class="identificacion">
        Proyecto Transversal · Grupo 3
      </p>
    </div>

    <div class="presentacion">
      <div>
        <p class="categoria">Un espacio para escucharse</p>

        <h1>
          A veces, cuidar<br>
          empieza por<br>
          <em>bajar el ritmo.</em>
        </h1>

        <p class="descripcion">
          Bienvenido a ADAGIO. Una consulta imaginaria donde
          las historias se encuentran, los silencios tienen
          lugar y la música acompaña lo que cuesta decir.
        </p>

        <!-- Este enlace baja hasta la consulta. -->
        <a class="boton" href="#consulta">
          Entrar en la consulta ↓
        </a>
      </div>

      <div>
        <div class="ilustracion">
          <svg
            viewBox="0 0 500 520"
            role="img"
            aria-labelledby="imagen-titulo imagen-descripcion"
            xmlns="http://www.w3.org/2000/svg"
          >
            <title id="imagen-titulo">La consulta de ADAGIO</title>
            <desc id="imagen-descripcion">
              Ilustración en tonos azules de un sillón junto
              a una ventana, una planta y una mesa con un cuaderno.
            </desc>

            <!-- Pared y suelo -->
            <rect width="500" height="520" fill="#335C81"/>
